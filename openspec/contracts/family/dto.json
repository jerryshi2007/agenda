{
  "CreateFamilyRequest": {
    "fields": {
      "name": {
        "type": "string",
        "required": true,
        "minLength": 2,
        "maxLength": 20
      },
      "role": {
        "type": "UserRole",
        "required": true
      }
    }
  },
  "UpdateFamilyNameRequest": {
    "fields": {
      "name": {
        "type": "string",
        "required": true,
        "minLength": 2,
        "maxLength": 20
      }
    }
  },
  "GenerateInviteCodeRequest": {
    "fields": {
      "targetRole": {
        "type": "UserRole",
        "required": true
      },
      "targetChildName": {
        "type": "string",
        "required": false,
        "maxLength": 20
      },
      "targetDisplayMode": {
        "type": "DisplayMode",
        "required": false
      }
    }
  },
  "JoinByCodeRequest": {
    "fields": {
      "code": {
        "type": "string",
        "required": true,
        "minLength": 6,
        "maxLength": 6,
        "pattern": "^[2-9]{6}$"
      }
    }
  },
  "SetDisplayModeRequest": {
    "fields": {
      "displayMode": {
        "type": "DisplayMode",
        "required": true
      }
    }
  },
  "DissolveFamilyRequest": {
    "fields": {
      "familyName": {
        "type": "string",
        "required": true
      }
    }
  },
  "FamilyInfo": {
    "fields": {
      "familyId": {
        "type": "Guid",
        "required": true
      },
      "familyName": {
        "type": "string",
        "required": true
      },
      "role": {
        "type": "UserRole",
        "required": true
      },
      "memberCount": {
        "type": "integer",
        "required": true
      },
      "lastActiveAt": {
        "type": "DateTimeOffset",
        "required": true
      }
    }
  },
  "FamilyMemberInfo": {
    "fields": {
      "memberId": {
        "type": "Guid",
        "required": true
      },
      "userId": {
        "type": "Guid",
        "required": true
      },
      "role": {
        "type": "UserRole",
        "required": true
      },
      "childName": {
        "type": "string",
        "required": false
      },
      "displayMode": {
        "type": "DisplayMode",
        "required": true
      },
