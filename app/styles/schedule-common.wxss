/* app/styles/schedule-common.wxss
   日程模块公共样式 —— 色条、状态标记、卡片布局 */

@import './tokens.wxss';

/* ----- 日程类型色条（卡片左侧竖线） ----- */
.schedule-stripe-activity {
  border-left: 6rpx solid var(--color-type-activity);
}

.schedule-stripe-routine {
  border-left: 6rpx solid var(--color-type-routine);
}

.schedule-stripe-homework {
  border-left: 6rpx solid var(--color-type-homework);
}

/* ----- 点标记 ----- */
.dot-activity {
  width: 14rpx;
  height: 14rpx;
  border-radius: var(--radius-round);
  background: var(--color-type-activity);
}

.dot-routine {
  width: 14rpx;
  height: 14rpx;
  border-radius: var(--radius-round);
  background: var(--color-type-routine);
}

.dot-homework {
  width: 14rpx;
  height: 14rpx;
  border-radius: var(--radius-round);
  background: var(--color-type-homework);
}

/* ----- 状态图标 ----- */
.status-icon-completed {
  color: var(--color-primary);
}

.status-icon-incomplete {
  color: var(--color-type-homework);
}

.status-icon-cancelled {
  color: var(--color-text-placeholder);
}

.status-icon-overdue {
  color: var(--color-danger);
}

/* ----- 日程卡片通用样式 ----- */
.schedule-card {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  margin: var(--spacing-sm) var(--spacing-md);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.schedule-card-header {
  display: flex;
  align-items: center;
  padding: var(--spacing-md);
}

.schedule-card-stripe {
  width: 6rpx;
  height: 100%;
  position: absolute;
  left: 0;
  top: 0;
  border-radius: var(--radius-md) 0 0 var(--radius-md);
}

.schedule-card-stripe-activity {
  background: var(--color-type-activity);
}

.schedule-card-stripe-routine {
  background: var(--color-type-routine);
}

.schedule-card-stripe-homework {
  background: var(--color-type-homework);
}

.schedule-card-body {
  flex: 1;
  min-width: 0;
  padding-left: var(--spacing-sm);
}

.schedule-card-name {
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-card-time {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: 4rpx;
}

.schedule-card-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: 6rpx;
}

.schedule-card-child {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.schedule-card-child-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-white);
  background: var(--color-type-activity);
}

.schedule-card-location {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.schedule-card-status {
  margin-left: auto;
  flex-shrink: 0;
}

.schedule-card-actions {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-left: var(--spacing-md);
}

/* ----- 视图切换组件 ----- */
.view-switcher {
  display: flex;
  border: 2rpx solid var(--color-border);
  border-radius: 12rpx;
  overflow: hidden;
}

.view-switcher-item {
  flex: 1;
  text-align: center;
  padding: 12rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg-white);
  border-right: 2rpx solid var(--color-border);
  transition: all var(--transition-fast);
}

.view-switcher-item:last-child {
  border-right: none;
}

.view-switcher-item.active {
  background: var(--color-primary);
  color: var(--color-text-white);
}

/* ----- 日期导航栏 ----- */
.date-navigator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 32rpx;
  background: var(--color-bg-white);
}

.date-nav-arrow {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: var(--color-text-primary);
  border-radius: var(--radius-round);
}

.date-nav-arrow:active {
  background: var(--color-bg-page);
}

.date-nav-title {
  flex: 1;
  text-align: center;
  font-size: var(--font-size-md);
  font-weight: 600;
  color: var(--color-text-primary);
}

.date-nav-today {
  position: absolute;
  right: 32rpx;
  font-size: var(--font-size-sm);
  color: var(--color-primary);
  padding: 4rpx 20rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: 24rpx;
  font-weight: 500;
}

.date-nav-today:active {
  background: var(--color-primary-light);
}

/* ----- 筛选栏 ----- */
.filter-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 32rpx 16rpx;
  background: var(--color-bg-white);
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
  border-radius: var(--radius-sm);
  gap: 8rpx;
}

.filter-item.active {
  color: var(--color-primary);
  background: var(--color-primary-light);
}

.filter-item-arrow {
  font-size: 20rpx;
  color: var(--color-text-placeholder);
}

/* ----- 星期头 ----- */
.weekday-header {
  display: flex;
  text-align: center;
  padding: 12rpx 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  background: var(--color-bg-white);
  border-bottom: 2rpx solid var(--color-border-light);
}

.weekday-header-item {
  flex: 1;
}

.weekday-header-item.weekend {
  color: var(--color-danger);
}

/* ----- 分段开关 (此组件/全部) ----- */
.segmented-switch {
  display: flex;
  background: var(--color-bg-page);
  border-radius: var(--radius-md);
  padding: 4rpx;
}

.segmented-switch-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  border-radius: var(--radius-md);
  transition: all var(--transition-fast);
}

.segmented-switch-item.active {
  background: var(--color-bg-white);
  color: var(--color-text-primary);
  font-weight: 500;
  box-shadow: var(--shadow-sm);
}

/* ----- 信息展示行（详情页） ----- */
.info-section {
  background: var(--color-bg-white);
  margin: 20rpx 0;
}

.info-section-title {
  padding: 24rpx 32rpx 8rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.info-row {
  display: flex;
  padding: 20rpx 32rpx;
  border-bottom: 2rpx solid var(--color-border-light);
  font-size: var(--font-size-base);
  align-items: flex-start;
}

.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 128rpx;
  flex-shrink: 0;
  color: var(--color-text-secondary);
}

.info-value {
  flex: 1;
  color: var(--color-text-primary);
  line-height: 1.5;
  word-break: break-all;
}
