<!-- pages/family-create/index.wxml -->
<view class="page-container safe-bottom">
  <view class="form-section">
    <view class="form-item">
      <view class="form-item__label">家庭名称</view>
      <input class="form-item__input" type="text" maxlength="20"
             placeholder="请输入家庭名称（2-20 字）"
             value="{{name}}" bindinput="onNameInput"
             data-id="create-family-name-input" />
    </view>
    <view class="form-item">
      <view class="form-item__label">字数</view>
      <view class="form-item__value">
        <text class="char-count {{charCount >= 18 ? 'warn' : ''}}">{{charCount}}/20</text>
      </view>
    </view>

    <view class="form-item">
      <view class="form-item__label">我的角色</view>
    </view>
    <view class="role-cards">
      <view class="role-card {{role === 'Parent' ? 'role-card--selected' : ''}}"
            data-id="create-family-role-parent" data-role="Parent" bindtap="onSelectRole">
        <text class="role-card__title">家长</text>
        <text class="role-card__desc">管理家庭、邀请成员、查看全部日程</text>
        <text wx:if="{{role === 'Parent'}}" class="role-check">&#x2713;</text>
      </view>
      <view class="role-card {{role === 'Child' ? 'role-card--selected' : ''}}"
            data-id="create-family-role-child" data-role="Child" bindtap="onSelectRole">
        <text class="role-card__title">孩子</text>
        <text class="role-card__desc">查看自己的日程、完成打卡任务</text>
        <text wx:if="{{role === 'Child'}}" class="role-check">&#x2713;</text>
      </view>
    </view>
  </view>

  <view wx:if="{{roleHint}}" class="role-hint">
    <text>&#x26A0;&#xFE0F; {{roleHint}}</text>
  </view>

  <view wx:if="{{error}}" class="error-text">{{error}}</view>

  <view class="submit-wrap">
    <button class="btn-primary btn-block btn-lg"
            data-id="create-family-submit-btn"
            bindtap="onSubmit"
            disabled="{{!valid || submitting}}">
      {{submitting ? '创建中...' : '创建'}}
    </button>
  </view>
</view>
