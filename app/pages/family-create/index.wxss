/* pages/family-create/index.wxss */
@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.form-section {
  background: var(--color-bg-white);
  margin: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border-light);
  min-height: 96rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item__label {
  width: 144rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.form-item__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
}

.form-item__value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: var(--color-text-primary);
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.form-item__arrow {
  display: inline-block;
  width: 16rpx;
  height: 16rpx;
  border-top: 2rpx solid var(--color-text-placeholder);
  border-right: 2rpx solid var(--color-text-placeholder);
  transform: rotate(45deg);
  margin-left: 16rpx;
}

.char-count {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
}

.char-count.warn {
  color: var(--color-warning);
}

.role-text--child {
  color: #10AEFF;
}

.role-hint {
  margin: 0 32rpx 24rpx;
  padding: 24rpx;
  background: #FFF7E6;
  color: #D48806;
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.error-text {
  margin: 0 32rpx 24rpx;
  color: var(--color-warning);
  font-size: 26rpx;
}

.submit-wrap {
  margin: 0 32rpx;
}

.role-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 1000;
}

.role-panel {
  width: 100%;
  background: var(--color-bg-white);
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  overflow: hidden;
}

.role-option {
  padding: 32rpx;
  text-align: center;
  border-bottom: 1rpx solid var(--color-border-light);
  font-size: 30rpx;
  color: var(--color-text-primary);
  position: relative;
}

.role-option:last-child {
  border-bottom: none;
}

.role-check {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  color: var(--color-primary);
  font-weight: 600;
  font-size: 36rpx;
}

.role-cards {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 0 32rpx 32rpx;
}

.role-card {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  padding: 28rpx 24rpx;
  background: var(--color-bg-white);
  border: 2rpx solid var(--color-border-light);
  border-radius: 12rpx;
  transition: all 0.15s;
}

.role-card--selected {
  border-color: var(--color-primary);
  background: #E8F8EE;
}

.role-card:active {
  background: #F5F5F5;
}

.role-card__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.role-card__desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  line-height: 1.4;
}
