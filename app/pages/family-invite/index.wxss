/* pages/family-invite/index.wxss */
@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.invite-page {
  padding: 0;
}

.invite-type-card {
  background: var(--color-bg-white);
  margin: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.invite-type-header {
  display: flex;
  align-items: center;
  padding: 32rpx;
}

.invite-type-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.invite-type-icon--parent {
  background: #E8F8EF;
  color: var(--color-primary);
}

.invite-type-icon--child {
  background: #E6F0FF;
  color: #10AEFF;
}

.invite-type-info {
  flex: 1;
}

.invite-type-title {
  font-size: 30rpx;
  color: var(--color-text-primary);
  font-weight: 500;
  margin-bottom: 8rpx;
}

.invite-type-desc {
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.invite-type-check {
  color: var(--color-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.invite-child-form {
  border-top: 1rpx solid var(--color-border-light);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--color-border-light);
  min-height: 96rpx;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item__label {
  width: 144rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  flex-shrink: 0;
}

.form-item__input {
  flex: 1;
  font-size: 28rpx;
  color: var(--color-text-primary);
  text-align: right;
}

.form-item__value.mode-picker {
  flex: 1;
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.mode-option {
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 24rpx;
  background: var(--color-bg-page);
  color: var(--color-text-secondary);
}

.mode-option.selected {
  background: var(--color-primary);
  color: var(--color-bg-white);
}

.error-text {
  margin: 0 32rpx 24rpx;
  color: var(--color-warning);
  font-size: 26rpx;
}

.submit-wrap {
  margin: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.invite-code-page {
  padding: 64rpx 32rpx;
  text-align: center;
}

.invite-code-title {
  font-size: 32rpx;
  color: var(--color-text-primary);
  margin-bottom: 32rpx;
}

.invite-code-display {
  background: var(--color-bg-white);
  border-radius: 16rpx;
  padding: 48rpx;
  margin-bottom: 32rpx;
  display: flex;
  justify-content: center;
  gap: 16rpx;
}

.code-digit-large {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--color-primary);
  font-family: monospace;
}

.invite-code-expire {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 64rpx;
}
