/* pages/child-today/index.wxss
   孩子今日只读视图（小学模式）—— 顶部进度条 + 列表项样式 */

@import '../../styles/common.wxss';

.page-container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* 视图切换器 */
.child-view-switcher {
  display: flex;
  background: var(--color-bg-white);
  padding: var(--spacing-sm) var(--spacing-md);
  border-bottom: 2rpx solid var(--color-border-light);
}

.child-view-switcher-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-sm) 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  border-radius: var(--radius-sm);
}

.child-view-switcher-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 500;
}

/* 进度区 */
.child-progress {
  background: var(--color-bg-white);
  padding: var(--spacing-lg) var(--spacing-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
}

.child-progress-text {
  font-size: var(--font-size-md);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
}

.child-progress-bar {
  height: 16rpx;
  background: var(--color-border-light);
  border-radius: var(--radius-round);
  overflow: hidden;
}

.child-progress-bar-fill {
  height: 100%;
  background: var(--color-primary);
  border-radius: var(--radius-round);
  transition: width var(--transition-base);
}

/* 列表 */
.child-list {
  padding: 0 var(--spacing-md) var(--spacing-md);
}

.child-item {
  display: flex;
  align-items: stretch;
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  margin-bottom: var(--spacing-md);
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.child-item-stripe {
  width: 8rpx;
  flex-shrink: 0;
}

.child-item-stripe-activity { background: var(--color-type-activity); }
.child-item-stripe-routine { background: var(--color-type-routine); }
.child-item-stripe-homework { background: var(--color-type-homework); }

.child-item-body {
  flex: 1;
  padding: var(--spacing-md);
  min-width: 0;
}

.child-item-top {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
}

.child-item-type-tag {
  flex-shrink: 0;
}

.child-item-name {
  flex: 1;
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.child-item-status-done {
  flex-shrink: 0;
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-round);
  background: var(--color-primary);
  color: var(--color-text-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-sm);
  font-weight: bold;
}

.child-item-time {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.child-item-checkin-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  font-size: var(--font-size-sm);
  font-weight: 500;
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-left: 2rpx solid var(--color-border-light);
  transition: background var(--transition-fast);
}

.child-item-checkin-btn:active {
  background: var(--color-primary);
  color: var(--color-text-white);
}

.child-item-checkin-btn-done {
  color: var(--color-text-secondary);
  background: var(--color-bg-page);
}

.child-item-checkin-btn-done:active {
  background: var(--color-border);
  color: var(--color-text-primary);
}
