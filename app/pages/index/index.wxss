/* pages/index/index.wxss */

@import '../../styles/schedule-common.wxss';

.page-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--color-bg-page);
}

.cal-header {
  background: var(--color-bg-white);
  border-bottom: 2rpx solid var(--color-border-light);
  flex-shrink: 0;
}

/* 浮动创建按钮 */
.float-create-btn {
  position: fixed;
  right: 32rpx;
  bottom: 120rpx;
  width: 104rpx;
  height: 104rpx;
  border-radius: var(--radius-round);
  background: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.35);
  z-index: 99;
  transition: all var(--transition-fast);
}

.float-create-btn:active {
  transform: scale(0.92);
  background: var(--color-primary-active);
}

.float-create-btn-icon {
  font-size: 56rpx;
  color: var(--color-text-white);
  font-weight: 300;
  line-height: 1;
}
