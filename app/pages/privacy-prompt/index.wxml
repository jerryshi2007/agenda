<!-- pages/privacy-prompt/index.wxml -->
<view class="page-container">
  <view class="prompt-card">
    <view class="prompt-icon">!</view>
    <view class="prompt-title">需要同意隐私政策才能使用</view>
    <view class="prompt-desc">您已拒绝隐私政策。家庭日程协作工具需要获得您的同意才能提供服务。您可以重新查看隐私政策，同意后即可继续使用。</view>
    <view class="btn btn-primary btn-block" data-id="privacy-prompt-review-btn" bindtap="onReview">重新查看隐私政策</view>
  </view>
</view>
