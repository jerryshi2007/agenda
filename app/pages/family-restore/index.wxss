/* pages/family-restore/index.wxss */

.page-container {
  min-height: 100vh;
  padding: 48rpx 32rpx 32rpx;
  background: var(--weui-BG-0, #EDEDED);
  display: flex;
  flex-direction: column;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 64rpx 0 48rpx;
}

.header__icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.header__title {
  font-size: 40rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
  text-align: center;
}

.header__subtitle {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.5);
  text-align: center;
}

.header__subtitle--expired {
  color: #C62828;
}

.info-block {
  background: #FFF;
  border-radius: 12rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
  font-size: 28rpx;
}

.info-row:last-child {
  border-bottom: none;
}

.info-row__label {
  color: rgba(0, 0, 0, 0.5);
}

.info-row__value {
  color: rgba(0, 0, 0, 0.9);
  font-weight: 500;
}

.error-message {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: #FFEBEE;
  color: #C62828;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.success-message {
  margin-bottom: 24rpx;
  padding: 16rpx 24rpx;
  background: #E8F5E9;
  color: #2E7D32;
  border-radius: 8rpx;
  font-size: 26rpx;
  text-align: center;
}

.footer {
  margin-top: auto;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding-top: 24rpx;
}

.btn-primary {
  background: #07C160;
  color: #FFF;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-primary[disabled] {
  background: #C8E6C9;
  color: rgba(255, 255, 255, 0.85);
}

.btn-secondary {
  background: #FFF;
  color: #555;
  border: 1rpx solid #DDD;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
}
