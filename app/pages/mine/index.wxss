/* pages/mine/index.wxss */
@import '../../styles/common.wxss';
@import '../../styles/tokens.wxss';

.page-container {
  padding: 32rpx;
  min-height: 100vh;
  background: var(--color-bg-page);
}

.section {
  background: var(--color-bg-container);
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.section-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.section-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-top: 8rpx;
}

.arrow {
  color: var(--color-text-placeholder);
  font-size: 36rpx;
}
