<!-- pages/schedule-edit/index.wxml
     编辑日程页 —— 复用 schedule-form 子组件 + editScope 范围开关 -->

<view class="edit-page">
  <!-- 编辑范围开关（非作业任务） -->
  <view wx:if="{{!isHomework}}" class="scope-section">
    <edit-scope-switch
      data-id="schedule-edit-scope"
      scope="{{editScope}}"
      bind:scopechange="onScopeChange"
    />
  </view>

  <!-- schedule-form 子组件：scheduleTypeLocked=true（编辑不可改类型） -->
  <scroll-view scroll-y enable-flex class="edit-content">
    <schedule-form
      id="schedule-form"
      mode="edit"
      schedule-type-locked="{{true}}"
      child-selector-visible="{{false}}"
      start-date-visible="{{false}}"
      initial-values="{{formData}}"
      bind:submit="onFormSubmit"
    />
  </scroll-view>

  <!-- 底部操作栏 -->
  <view class="edit-footer safe-area-bottom">
    <view class="btn btn-primary btn-block" data-id="schedule-edit-save-btn"
          bindtap="onSave" loading="{{saving}}">
      {{saving ? '保存中...' : '保存修改'}}
    </view>
  </view>
</view>
