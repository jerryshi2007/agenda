/* app/styles/common.wxss
   公共样式 —— 全局 Reset + 通用组件样式 */

@import './tokens.wxss';

/* ----- Reset ----- */
page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC",
               "Hiragino Sans GB", "Microsoft YaHei", "Helvetica Neue", Arial,
               sans-serif;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  line-height: var(--line-height-base);
  font-size: var(--font-size-base);
  -webkit-font-smoothing: antialiased;
}

/* ----- 通用按钮 ----- */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 var(--spacing-lg);
  font-size: var(--font-size-md);
  font-weight: 500;
  border-radius: var(--radius-sm);
  transition: all var(--transition-fast);
  box-sizing: border-box;
}

.btn-primary {
  background: var(--color-primary);
  color: var(--color-text-white);
}

.btn-primary:active {
  background: var(--color-primary-active);
}

.btn-primary[disabled] {
  background: #B2DFC9;
  color: rgba(255, 255, 255, 0.7);
}

.btn-default {
  background: var(--color-bg-white);
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border);
}

.btn-default:active {
  background: var(--color-bg-page);
}

.btn-danger {
  background: var(--color-danger);
  color: var(--color-text-white);
}

.btn-danger:active {
  background: #E04848;
}

.btn-sm {
  height: 64rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-sm);
}

.btn-block {
  width: 100%;
}

/* ----- 空态 ----- */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-lg);
}

.empty-state-icon {
  width: 128rpx;
  height: 128rpx;
  margin-bottom: var(--spacing-lg);
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-state-icon image {
  width: 96rpx;
  height: 96rpx;
}

.empty-state-title {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  font-weight: 500;
}

.empty-state-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  text-align: center;
  line-height: 1.6;
}

/* ----- 错误态 ----- */
.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx var(--spacing-lg);
}

.error-state-title {
  font-size: var(--font-size-md);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-sm);
  font-weight: 500;
}

.error-state-desc {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

/* ----- 加载态 ----- */
.loading-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: var(--spacing-xl);
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid var(--color-border-light);
  border-top-color: var(--color-primary);
  border-radius: var(--radius-round);
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: var(--spacing-md);
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

/* ----- 骨架屏 ----- */
.skeleton-line {
  height: 28rpx;
  background: linear-gradient(90deg, var(--color-border-light) 25%, #E8E8E8 50%, var(--color-border-light) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease infinite;
  border-radius: var(--radius-sm);
}

.skeleton-block {
  background: linear-gradient(90deg, var(--color-border-light) 25%, #E8E8E8 50%, var(--color-border-light) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease infinite;
  border-radius: var(--radius-sm);
}

@keyframes skeleton-shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* ----- 分割线 ----- */
.divider {
  height: 2rpx;
  background: var(--color-border-light);
  margin: var(--spacing-md) 0;
}

/* ----- 标签 ----- */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 12rpx;
  font-size: var(--font-size-xs);
  border-radius: 24rpx;
}

.tag-activity {
  background: var(--color-type-activity-bg);
  color: var(--color-type-activity);
}

.tag-routine {
  background: var(--color-type-routine-bg);
  color: var(--color-type-routine);
}

.tag-homework {
  background: var(--color-type-homework-bg);
  color: var(--color-type-homework);
}

/* ----- 工具类 ----- */
.text-center { text-align: center; }
.text-secondary { color: var(--color-text-secondary); }
.mt-sm { margin-top: var(--spacing-sm); }
.mt-md { margin-top: var(--spacing-md); }
.mt-lg { margin-top: var(--spacing-lg); }
.mb-sm { margin-bottom: var(--spacing-sm); }
.mb-md { margin-bottom: var(--spacing-md); }
.hidden { display: none !important; }

/* ----- 骨架屏（补充） ----- */
.skeleton {
  background: linear-gradient(90deg, var(--color-border-light) 25%, #E8E8E8 50%, var(--color-border-light) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease infinite;
  border-radius: var(--radius-sm);
}

.skeleton-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-round);
  background: linear-gradient(90deg, var(--color-border-light) 25%, #E8E8E8 50%, var(--color-border-light) 75%);
  background-size: 200% 100%;
  animation: skeleton-shimmer 1.5s ease infinite;
}

/* ----- 底部安全区域工具类 ----- */
.safe-bottom {
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}
