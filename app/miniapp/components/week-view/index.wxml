<!-- components/week-view/index.wxml
     周视图 —— 7 列时间网格（每天一列），紧凑 mini 卡片落在对应天列 -->
<view class="week-container">
  <!-- 星期头 -->
  <view class="weekday-header">
    <view wx:for="{{weekDays}}" wx:key="date" class="weekday-header-item {{item.isWeekend ? 'weekend' : ''}} {{item.isToday ? 'weekday-today' : ''}}"
          data-id="calendar-week-header-cell-{{item.date}}" bindtap="onWeekDayTap" data-date="{{item.date}}">
      <text class="weekday-name">{{item.dayOfWeekName}}</text>
      <text class="weekday-day {{item.isToday ? 'weekday-day-today' : ''}}">{{item.day}}</text>
    </view>
  </view>

  <!-- 7 列时间网格 -->
  <scroll-view scroll-y enable-flex class="week-body">
    <view wx:if="{{schedules.length === 0 && !loading}}" class="empty-state">
      <text class="empty-state-desc">该周暂无日程</text>
    </view>

    <view class="week-grid">
      <view wx:for="{{weekDays}}" wx:key="date" wx:for-item="day"
            class="week-col {{day.isToday ? 'week-col-today' : ''}}"
            data-id="calendar-week-col-{{day.date}}">
        <mini-schedule-card wx:for="{{day.schedules}}" wx:key="scheduleId"
          schedule="{{item}}"
          bind:cardtap="onCardTap"
          bind:checkintap="onCheckinTap"
        />
      </view>
    </view>
  </scroll-view>
</view>
