/* components/mini-schedule-card/index.wxss */

@import '../../styles/schedule-common.wxss';

.mini-card {
  position: relative;
  border-radius: var(--radius-md);
  padding: 8rpx 10rpx;
  margin: 4rpx 2rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

/* 按类型着色背景（对应原型 mc-activity/routine/homework） */
.mini-card-activity {
  background: var(--color-type-activity-bg);
}

.mini-card-routine {
  background: var(--color-type-routine-bg);
}

.mini-card-homework {
  background: var(--color-type-homework-bg);
}

.mini-card-stripe {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 6rpx;
}

.mini-card-stripe-activity {
  background: var(--color-type-activity);
}

.mini-card-stripe-routine {
  background: var(--color-type-routine);
}

.mini-card-stripe-homework {
  background: var(--color-type-homework);
}

.mini-card-content {
  display: flex;
  flex-direction: column;
  gap: 2rpx;
  min-width: 0;
}

.mini-card-time {
  font-size: 18rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mini-card-title {
  font-size: 20rpx;
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mini-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 4rpx;
  margin-top: 2rpx;
}

.mini-card-avatar {
  width: 28rpx;
  height: 28rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16rpx;
  color: var(--color-text-white);
  flex-shrink: 0;
}

.mini-card-avatar-activity {
  background: var(--color-type-activity);
}

.mini-card-avatar-routine {
  background: var(--color-type-routine);
}

.mini-card-avatar-homework {
  background: var(--color-type-homework);
}

.mini-card-checkin {
  width: 32rpx;
  height: 32rpx;
  border-radius: var(--radius-round);
  background: var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: bold;
  border: 2rpx solid var(--color-primary);
  flex-shrink: 0;
}

.mini-card-checkin:active {
  background: var(--color-primary);
  color: var(--color-text-white);
}

.mini-card-status {
  font-size: 16rpx;
  flex-shrink: 0;
}

.mini-card-status-completed {
  color: var(--color-primary);
  font-weight: 600;
}

.mini-card-status-cancelled {
  color: var(--color-text-placeholder);
}

.mini-card-status-overdue {
  color: var(--color-danger);
  font-weight: 600;
}

/* 已完成 / 已取消：整卡弱化（参照原型 mc-done / mc-cancelled） */
.mini-card-done {
  opacity: 0.6;
}

.mini-card-done .mini-card-title {
  text-decoration: line-through;
}
