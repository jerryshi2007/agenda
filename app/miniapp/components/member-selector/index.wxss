/* components/member-selector/index.wxss
   关联成员选择器样式 —— 复用 schedule-form 的 child-select 视觉 */

.member-select-item {
  display: flex;
  align-items: center;
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
  border: 2rpx solid transparent;
}

.member-select-item.selected {
  border-color: #07C160;
  background: rgba(7, 193, 96, 0.06);
}

.member-select-item.locked {
  opacity: 0.85;
}

.member-select-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid #ccc;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #07C160;
  font-size: 28rpx;
  background: #fff;
}

.member-select-item.selected .member-select-check {
  background: #07C160;
  border-color: #07C160;
  color: #fff;
}

.member-select-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: 500;
  margin-right: 20rpx;
}

.member-select-info {
  flex: 1;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.member-select-name {
  font-size: 30rpx;
  color: #333;
}

.member-select-role {
  font-size: 22rpx;
  color: #07C160;
  background: rgba(7, 193, 96, 0.1);
  padding: 2rpx 12rpx;
  border-radius: 8rpx;
}

/* 空态 */
.empty-state {
  padding: 32rpx;
  text-align: center;
}

.empty-state-desc {
  color: #888;
  font-size: 26rpx;
}
