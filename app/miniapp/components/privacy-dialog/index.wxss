/* app/components/privacy-dialog/index.wxss */
@import '../../styles/common.wxss';

.privacy-dialog-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: var(--color-bg-mask);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.privacy-dialog {
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  padding: 48rpx 40rpx;
  width: 100%;
  max-width: 600rpx;
  box-sizing: border-box;
}

.privacy-dialog-title {
  font-size: var(--font-size-xl);
  font-weight: 700;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: var(--spacing-lg);
}

.privacy-dialog-body {
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
  line-height: 1.8;
  margin-bottom: var(--spacing-xl);
}

.privacy-dialog-body text {
  display: block;
}

.privacy-dialog-link {
  color: var(--color-text-link);
  margin-top: var(--spacing-sm);
}

.privacy-dialog-check {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-xl);
}

.privacy-dialog-check label {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.privacy-dialog-actions {
  display: flex;
  gap: var(--spacing-lg);
}

.privacy-dialog-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--radius-sm);
  font-size: var(--font-size-md);
  font-weight: 500;
}

.privacy-dialog-btn.decline {
  background: var(--color-bg-white);
  color: var(--color-text-primary);
  border: 2rpx solid var(--color-border);
}

.privacy-dialog-btn.agree {
  background: var(--color-primary);
  color: var(--color-text-white);
}

.privacy-dialog-btn.agree.disabled {
  background: #B2DFC9;
  color: rgba(255, 255, 255, 0.7);
}

.privacy-dialog-loading {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--spacing-md);
  border-radius: var(--radius-lg);
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
}
