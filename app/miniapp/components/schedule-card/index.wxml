<!-- components/schedule-card/index.wxml
     日程卡片 —— 色条 + 时间范围 + 名称 + 状态标签 + 类型标签 + 成员 + 地点 + 备注 + 快捷打卡 -->

<view class="schedule-card {{statusKey === 'cancelled' ? 'schedule-card-cancelled' : ''}}"
      data-id="calendar-schedule-card-{{schedule.scheduleId}}"
      bindtap="onCardTap">
  <view class="schedule-card-stripe schedule-card-stripe-{{stripeClass}}"></view>

  <view class="schedule-card-body">
    <!-- 顶部行：时间范围 + 状态标签 -->
    <view class="schedule-card-top">
      <text wx:if="{{timeText}}" class="schedule-card-time">{{timeText}}</text>
      <view class="schedule-card-status">
        <!-- 已完成 -->
        <text wx:if="{{statusKey === 'completed'}}" class="tag tag-status-completed">已完成</text>
        <!-- 未完成 -->
        <text wx:elif="{{statusKey === 'incomplete'}}" class="tag tag-status-incomplete">未完成</text>
        <!-- 已取消 -->
        <text wx:elif="{{statusKey === 'cancelled'}}" class="tag tag-status-cancelled">已取消</text>
        <!-- 已逾期 -->
        <text wx:elif="{{statusKey === 'overdue'}}" class="tag tag-status-overdue">已逾期</text>
      </view>
    </view>

    <!-- 名称 -->
    <text class="schedule-card-name {{statusKey === 'cancelled' ? 'schedule-card-name-cancelled' : ''}}">{{schedule.name}}</text>

    <!-- 元信息行 -->
    <view class="schedule-card-meta">
      <!-- 类型标签 -->
      <text wx:if="{{viewType === 'day'}}" class="tag tag-{{stripeClass}}">
        {{typeLabel}}
      </text>

      <!-- 成员信息 -->
      <view wx:if="{{memberName}}" class="schedule-card-child">
        <view wx:if="{{memberAvatarUrl}}" class="schedule-card-child-avatar">
          <image src="{{memberAvatarUrl}}" style="width:36rpx;height:36rpx;border-radius:50%;" />
        </view>
        <view wx:else class="schedule-card-child-avatar">
          {{memberName.charAt(0)}}
        </view>
        <text>{{memberName}}</text>
      </view>

      <!-- 地点（日视图显示） -->
      <text wx:if="{{viewType === 'day' && schedule.location}}" class="schedule-card-location">
        📍 {{schedule.location}}
      </text>
    </view>

    <!-- 备注（仅日视图显示） -->
    <view wx:if="{{viewType === 'day' && schedule.notes}}" class="schedule-card-notes">
      {{schedule.notes}}
    </view>
  </view>

  <!-- 快捷打卡按钮（未完成态） -->
  <view wx:if="{{statusKey === 'incomplete'}}"
        class="schedule-card-checkin"
        data-id="calendar-schedule-card-checkin-btn-{{schedule.scheduleId}}"
        catchtap="onCheckinTap">
    <text class="checkin-icon">✓</text>
  </view>
</view>
