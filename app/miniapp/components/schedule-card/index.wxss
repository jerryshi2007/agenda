/* components/schedule-card/index.wxss */

/* 共享样式：.schedule-card 基础（色条/圆角/阴影/对齐）定义在 schedule-common.wxss（组件样式隔离，需显式引用） */
@import '../../styles/schedule-common.wxss';

/* 卡片正文 */
.schedule-card-body {
  flex: 1;
  min-width: 0;
  padding: var(--spacing-md);
}

/* 顶部行：时间范围 + 状态标签 */
.schedule-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--spacing-sm);
}

.schedule-card-time {
  flex: 1;
  min-width: 0;
  font-size: var(--font-size-base);
  font-weight: 600;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-card-status {
  flex-shrink: 0;
}

/* 名称 */
.schedule-card-name {
  font-size: var(--font-size-md);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-top: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.schedule-card-name-cancelled {
  color: var(--color-text-placeholder);
  text-decoration: line-through;
}

/* 已取消：整卡弱化（同原型 event-card--cancelled / mini-card-done） */
.schedule-card-cancelled {
  opacity: 0.6;
}

/* ----- 状态标签（语义色，独立于日程类型色） ----- */
.tag-status-completed {
  background: var(--color-type-routine-bg);
  color: var(--color-type-routine);
}

.tag-status-incomplete {
  background: var(--color-type-homework-bg);
  color: var(--color-type-homework);
}

.tag-status-cancelled {
  background: var(--color-bg-page);
  color: var(--color-text-placeholder);
}

.tag-status-overdue {
  background: var(--color-danger-light);
  color: var(--color-danger);
}

/* 元信息行 */
.schedule-card-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.schedule-card-child {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.schedule-card-child-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-white);
  background: var(--color-type-activity);
  flex-shrink: 0;
}

.schedule-card-location {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  display: flex;
  align-items: center;
  gap: 2rpx;
}

/* 备注：最多 2 行截断 */
.schedule-card-notes {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* 快捷打卡按钮 */
.schedule-card-checkin {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  flex-shrink: 0;
}

.checkin-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-round);
  background: var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-md);
  font-weight: bold;
  border: 3rpx solid var(--color-primary);
}

.checkin-icon:active {
  background: var(--color-primary);
  color: var(--color-text-white);
}
