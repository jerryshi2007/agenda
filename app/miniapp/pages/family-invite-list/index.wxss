/* pages/family-invite-list/index.wxss */
@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.invite-section {
  background: var(--color-bg-white);
  margin: 32rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.section-title {
  padding: 24rpx 32rpx 16rpx;
  font-size: 26rpx;
  color: var(--color-text-secondary);
  font-weight: 500;
}

.invite-item {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid var(--color-border-light);
}

.invite-item--used {
  opacity: 0.6;
}

.invite-item-main {
  flex: 1;
}

.invite-code {
  font-size: 32rpx;
  font-weight: 600;
  font-family: monospace;
  color: var(--color-text-primary);
  letter-spacing: 4rpx;
  margin-bottom: 4rpx;
}

.invite-meta {
  font-size: 22rpx;
  color: var(--color-text-secondary);
}

.invite-status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  margin-right: 16rpx;
}

.status-pending {
  color: var(--color-primary);
  background: #E8F8EF;
}

.status-used {
  color: var(--color-text-secondary);
  background: #F0F0F0;
}

.status-redeemed {
  color: var(--color-warning);
  background: #FFF7E6;
}

.status-expired {
  color: var(--color-text-secondary);
  background: #F0F0F0;
}

.invite-action {
  color: var(--color-warning);
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}

.error-state {
  padding: 128rpx 32rpx;
  text-align: center;
}

.error-state__icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.error-state__title {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

.empty-state {
  padding: 128rpx 32rpx;
  text-align: center;
}

.empty-state__icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-state__text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}
