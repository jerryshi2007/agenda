/* pages/family-welcome/index.wxss */
@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.welcome-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  padding: 96rpx 64rpx;
  box-sizing: border-box;
}

.welcome-illust {
  width: 240rpx;
  height: 240rpx;
  margin-bottom: 64rpx;
  background: var(--color-primary-light);
  border-radius: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 112rpx;
}

.welcome-title {
  font-size: 44rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 16rpx;
  text-align: center;
}

.welcome-desc {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  text-align: center;
  margin-bottom: 96rpx;
  line-height: 1.6;
}

.welcome-actions {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
