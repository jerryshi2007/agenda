/* pages/family-switch/index.wxss */

.page-container {
  min-height: 100vh;
  padding: 0 32rpx 32rpx;
  background: var(--weui-BG-0, #EDEDED);
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.loading-block {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #E5E5E5;
  border-top-color: #07C160;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  color: #888;
  font-size: 28rpx;
}

.error-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.error-state__icon {
  font-size: 96rpx;
}

.error-state__title {
  margin-top: 24rpx;
  margin-bottom: 32rpx;
  color: #555;
  font-size: 28rpx;
}

.btn-primary {
  background: #07C160;
  color: #FFF;
  border: none;
  border-radius: 8rpx;
  padding: 20rpx 48rpx;
  font-size: 30rpx;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 200rpx 0;
}

.empty-state__icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-state__text {
  color: rgba(0, 0, 0, 0.5);
  font-size: 28rpx;
}

.header {
  padding: 32rpx 0 24rpx;
}

.header__title {
  font-size: 40rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.header__subtitle {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.family-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.family-card {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  background: #FFF;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
  transition: all 0.15s;
}

.family-card--current {
  background: #F0FFF4;
  border-color: #07C160;
}

.family-card:active {
  background: #F5F5F5;
}

.family-card__icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E0F2F1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 20rpx;
}

.family-card__info {
  flex: 1;
}

.family-card__name {
  font-size: 32rpx;
  color: rgba(0, 0, 0, 0.9);
  font-weight: 500;
}

.family-card__meta {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.family-card__badge {
  background: #07C160;
  color: #FFF;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-weight: 500;
}

.family-card__arrow {
  color: rgba(0, 0, 0, 0.3);
  font-size: 48rpx;
  line-height: 1;
}
