/* pages/family-join/index.wxss */
@import '../../styles/tokens.wxss';
@import '../../styles/common.wxss';

.join-page {
  padding: 48rpx 32rpx;
}

.invite-code-section {
  background: var(--color-bg-white);
  border-radius: 16rpx;
  padding: 48rpx 32rpx;
  margin-bottom: 48rpx;
  text-align: center;
}

.invite-code-title {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  margin-bottom: 32rpx;
}

.code-input-group {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  position: relative;
}

.code-digit {
  width: 88rpx;
  height: 104rpx;
  border: 2rpx solid var(--color-border);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  background: var(--color-bg-page);
}

.code-digit.filled {
  border-color: var(--color-primary);
  background: var(--color-bg-white);
}

.code-digit.error {
  border-color: var(--color-warning);
}

.code-hidden-input {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 104rpx;
  opacity: 0;
  text-align: center;
}

.code-hint {
  font-size: 24rpx;
  color: var(--color-text-placeholder);
  margin-top: 16rpx;
}

.error-text {
  margin: 0 32rpx 24rpx;
  color: var(--color-warning);
  font-size: 26rpx;
  text-align: center;
}

.submit-wrap {
  margin: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
