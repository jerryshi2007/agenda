/* pages/child-month/index.wxss
   孩子月只读视图（小学模式） */

@import '../../styles/common.wxss';

.page-container {
  min-height: 100vh;
  background: var(--color-bg-page);
}

/* 视图切换器 */
.child-view-switcher {
  display: flex;
  background: var(--color-bg-white);
  padding: var(--spacing-sm) var(--spacing-md);
  border-bottom: 2rpx solid var(--color-border-light);
}

.child-view-switcher-item {
  flex: 1;
  text-align: center;
  padding: var(--spacing-sm) 0;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  border-radius: var(--radius-sm);
}

.child-view-switcher-item.active {
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 500;
}

/* 星期头 */
.child-month-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: var(--color-bg-white);
  padding: var(--spacing-md) 0;
  border-bottom: 2rpx solid var(--color-border-light);
}

.child-month-header-cell {
  text-align: center;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  font-weight: 500;
}

.child-month-header-weekend {
  color: var(--color-text-primary);
}

/* 月网格 */
.child-month-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  background: var(--color-bg-white);
  padding: var(--spacing-sm) 0;
}

.child-month-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: var(--spacing-md) 0;
  min-height: 100rpx;
  border-right: 2rpx solid var(--color-border-light);
  border-bottom: 2rpx solid var(--color-border-light);
}

.child-month-cell:nth-child(7n) {
  border-right: none;
}

.child-month-cell-other {
  color: var(--color-text-placeholder);
}

.child-month-cell-other .child-month-day {
  color: var(--color-text-placeholder);
}

.child-month-cell-weekend {
  background: var(--color-bg-page);
}

.child-month-cell-today {
  background: var(--color-primary-light);
}

.child-month-day {
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  margin-bottom: 4rpx;
}

.child-month-day-today {
  color: var(--color-primary);
  font-weight: 600;
}

.child-month-dots {
  display: flex;
  flex-direction: row;
  gap: 4rpx;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
  max-width: 80rpx;
}

.child-month-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: var(--radius-round);
}

.child-month-dot-activity { background: var(--color-type-activity); }
.child-month-dot-routine { background: var(--color-type-routine); }
.child-month-dot-homework { background: var(--color-type-homework); }
