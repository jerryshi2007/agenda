/* pages/schedule-create/index.wxss */

@import '../../styles/schedule-common.wxss';

.create-page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

/* 步骤条 */
.steps {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background: var(--color-bg-white);
  border-bottom: 2rpx solid var(--color-border-light);
  flex-shrink: 0;
}

.step {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-placeholder);
}

.step.active { color: var(--color-primary); }
.step.done { color: var(--color-primary); }

.step-num {
  width: 40rpx;
  height: 40rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  font-weight: 600;
  background: var(--color-border-light);
  color: var(--color-text-placeholder);
  flex-shrink: 0;
}

.step.active .step-num { background: var(--color-primary); color: var(--color-text-white); }
.step.done .step-num { background: var(--color-primary); color: var(--color-text-white); }

.step-line {
  flex: 1;
  height: 4rpx;
  background: var(--color-border-light);
  margin: 0 8rpx;
}

.step-line.done { background: var(--color-primary); }

/* 步骤内容区 */
.step-content {
  flex: 1;
  padding: var(--spacing-md);
}

/* 孩子选择 */
.child-select-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background: var(--color-bg-white);
  border-bottom: 2rpx solid var(--color-border-light);
  gap: 24rpx;
}

.child-select-item.selected {
  background: var(--color-primary-light);
}

.child-select-item:active {
  background: var(--color-bg-page);
}

.child-select-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: var(--radius-round);
  border: 4rpx solid var(--color-border);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

.child-select-item.selected .child-select-check {
  background: var(--color-primary);
  border-color: var(--color-primary);
  color: var(--color-text-white);
}

.child-select-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-text-white);
  font-size: 32rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.child-select-info { flex: 1; }
.child-select-name { font-size: var(--font-size-md); color: var(--color-text-primary); }

/* 类型卡片 */
.type-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.type-card {
  background: var(--color-bg-white);
  border: 4rpx solid var(--color-border);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  transition: all var(--transition-fast);
}

.type-card.selected { border-color: var(--color-primary); }
.type-card-activity:active { border-color: var(--color-type-activity); }
.type-card-routine:active { border-color: var(--color-type-routine); }
.type-card-homework:active { border-color: var(--color-type-homework); }

.type-card-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  flex-shrink: 0;
}

.type-card-icon-activity { background: var(--color-type-activity-bg); }
.type-card-icon-routine { background: var(--color-type-routine-bg); }
.type-card-icon-homework { background: var(--color-type-homework-bg); }

.type-card-info { flex: 1; }
.type-card-name { font-size: var(--font-size-md); font-weight: 500; color: var(--color-text-primary); }
.type-card-desc { font-size: var(--font-size-sm); color: var(--color-text-secondary); margin-top: 4rpx; }

.type-card-check {
  font-size: 48rpx;
  color: var(--color-primary);
  flex-shrink: 0;
}

/* 表单 */
.form-block {
  background: var(--color-bg-white);
  border-radius: var(--radius-md);
  padding: var(--spacing-md);
}

.form-group { margin-bottom: var(--spacing-lg); }
.form-label { font-size: var(--font-size-base); color: var(--color-text-secondary); margin-bottom: var(--spacing-sm); font-weight: 500; }

.required { color: var(--color-danger); }

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 var(--spacing-md);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.form-input:focus { border-color: var(--color-primary); background: var(--color-bg-white); }

.form-picker-value {
  display: flex;
  align-items: center;
  color: var(--color-text-primary);
}

.form-picker-value.half { flex: 1; justify-content: center; }

.form-row {
  display: flex;
  align-items: center;
}

.form-textarea {
  width: 100%;
  min-height: 120rpx;
  padding: var(--spacing-md);
  font-size: var(--font-size-base);
  color: var(--color-text-primary);
  background: var(--color-bg-page);
  border: 2rpx solid transparent;
  border-radius: var(--radius-sm);
  box-sizing: border-box;
}

.form-textarea:focus { border-color: var(--color-primary); background: var(--color-bg-white); }

.form-error {
  font-size: var(--font-size-sm);
  color: var(--color-danger);
  margin-top: var(--spacing-xs);
}

/* 确认预览 */
.confirm-block { padding: var(--spacing-md); }

.preview-card {
  background: var(--color-bg-white);
  border-radius: var(--radius-lg);
  padding: var(--spacing-lg);
  margin-top: var(--spacing-md);
}

.preview-type-tag { margin-bottom: var(--spacing-sm); }

.preview-name {
  font-size: var(--font-size-xl);
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: var(--spacing-lg);
}

.preview-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 2rpx solid var(--color-border-light);
}

.preview-label {
  width: 128rpx;
  flex-shrink: 0;
  color: var(--color-text-secondary);
  font-size: var(--font-size-base);
}

.preview-value {
  flex: 1;
  color: var(--color-text-primary);
  font-size: var(--font-size-base);
}

/* 底部操作栏 */
.create-footer {
  display: flex;
  padding: var(--spacing-md);
  background: var(--color-bg-white);
  border-top: 2rpx solid var(--color-border-light);
  gap: var(--spacing-md);
  flex-shrink: 0;
}

.create-footer .btn { flex: 1; }

/* 冲突弹窗 */
.conflict-item {
  display: flex;
  justify-content: space-between;
  padding: 8rpx 0;
  font-size: var(--font-size-base);
}

.conflict-name { color: var(--color-text-primary); }
.conflict-time { color: var(--color-text-secondary); }
