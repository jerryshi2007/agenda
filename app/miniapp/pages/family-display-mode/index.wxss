/* pages/family-display-mode/index.wxss */

.page-container {
  min-height: 100vh;
  padding: 32rpx;
  background: var(--weui-BG-0, #EDEDED);
  display: flex;
  flex-direction: column;
}

.safe-bottom {
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.header {
  padding: 32rpx 0 24rpx;
}

.header__title {
  font-size: 40rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.header__subtitle {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.5);
}

.mode-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.mode-card {
  display: flex;
  align-items: center;
  padding: 32rpx 28rpx;
  background: #FFF;
  border: 2rpx solid transparent;
  border-radius: 16rpx;
  transition: all 0.15s;
}

.mode-card--selected {
  border-color: #07C160;
  background: #F0FFF4;
}

.mode-card__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  margin-right: 24rpx;
}

.mode-card__icon--preschool {
  background: #FFE082;
}

.mode-card__icon--primary {
  background: #80CBC4;
}

.mode-card__icon--uppergrades {
  background: #90CAF9;
}

.mode-card__info {
  flex: 1;
}

.mode-card__label {
  font-size: 32rpx;
  font-weight: 600;
  color: rgba(0, 0, 0, 0.9);
}

.mode-card__desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.5);
}

.mode-card__check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #07C160;
  color: #FFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
}

.error-message {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: #FFEBEE;
  color: #C62828;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.success-message {
  margin-top: 24rpx;
  padding: 16rpx 24rpx;
  background: #E8F5E9;
  color: #2E7D32;
  border-radius: 8rpx;
  font-size: 26rpx;
}

.footer {
  margin-top: auto;
  padding-top: 24rpx;
}

.safe-bottom-pad {
  padding-bottom: env(safe-area-inset-bottom);
}

.btn-save {
  width: 100%;
  background: #07C160;
  color: #FFF;
  border: none;
  border-radius: 12rpx;
  padding: 24rpx 0;
  font-size: 32rpx;
  font-weight: 500;
}

.btn-save--disabled,
.btn-save[disabled] {
  background: #C8E6C9;
  color: rgba(255, 255, 255, 0.85);
}
