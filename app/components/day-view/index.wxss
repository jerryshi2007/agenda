/* components/day-view/index.wxss */

.day-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-page);
}

.day-body {
  flex: 1;
  padding: var(--spacing-sm) 0;
}

.day-schedule-item {
  display: flex;
}

/* schedule-card 宿主占满整行宽度 */
.day-schedule-card {
  flex: 1;
  min-width: 0;
}
