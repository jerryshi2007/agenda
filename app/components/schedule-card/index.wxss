/* components/schedule-card/index.wxss */

@import '../../styles/schedule-common.wxss';

.schedule-card {
  padding-left: 16rpx;
}

.schedule-card-body {
  flex: 1;
  padding: var(--spacing-md);
}

.schedule-card-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.schedule-card-name {
  font-size: var(--font-size-base);
  font-weight: 500;
  color: var(--color-text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  flex: 1;
}

.schedule-card-status {
  flex-shrink: 0;
  margin-left: var(--spacing-sm);
}

.schedule-card-time {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  margin-top: 6rpx;
}

.schedule-card-meta {
  display: flex;
  align-items: center;
  gap: var(--spacing-sm);
  margin-top: 8rpx;
  flex-wrap: wrap;
}

.schedule-card-child {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.schedule-card-child-avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: var(--radius-round);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-xs);
  color: var(--color-text-white);
  background: var(--color-type-activity);
  flex-shrink: 0;
}

.schedule-card-location {
  font-size: var(--font-size-xs);
  color: var(--color-text-placeholder);
  display: flex;
  align-items: center;
  gap: 2rpx;
}

.schedule-card-notes {
  font-size: var(--font-size-xs);
  color: var(--color-text-secondary);
  margin-top: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 快捷打卡按钮 */
.schedule-card-checkin {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  flex-shrink: 0;
}

.checkin-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: var(--radius-round);
  background: var(--color-primary-light);
  color: var(--color-primary);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--font-size-md);
  font-weight: bold;
  border: 3rpx solid var(--color-primary);
}

.checkin-icon:active {
  background: var(--color-primary);
  color: var(--color-text-white);
}
