/* components/use-template-dialog/index.wxss
   使用模板弹窗样式 —— 复用 modal 视觉 */

.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal {
  width: 90%;
  max-width: 600rpx;
  max-height: 80vh;
  background: #fff;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}

.modal__header {
  padding: 32rpx 24rpx 16rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #333;
  text-align: center;
  border-bottom: 1rpx solid #EDEDED;
}

.modal__body {
  padding: 16rpx 24rpx;
  overflow-y: auto;
  flex: 1;
}

.modal__section {
  padding: 16rpx 24rpx;
  border-top: 1rpx solid #F7F7F7;
}

.section-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.required {
  color: #FA5151;
}

.template-preview {
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-bottom: 8rpx;
}

.preview-row {
  display: flex;
  padding: 8rpx 0;
  font-size: 26rpx;
}

.preview-label {
  color: #888;
  width: 120rpx;
  flex-shrink: 0;
}

.preview-value {
  color: #333;
  flex: 1;
}

.selected-child {
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
}

.form-input,
.form-picker-value {
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  min-height: 40rpx;
}

.form-picker-value {
  display: flex;
  align-items: center;
}

.form-textarea {
  background: #F7F7F7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  color: #333;
  width: calc(100% - 48rpx);
  min-height: 120rpx;
  box-sizing: border-box;
}

.modal__footer {
  display: flex;
  border-top: 1rpx solid #EDEDED;
}

.modal__footer .btn {
  flex: 1;
  border-radius: 0;
  padding: 28rpx 0;
  text-align: center;
  font-size: 30rpx;
}

.btn-default {
  background: #fff;
  color: #333;
  border-right: 1rpx solid #EDEDED;
}

.btn-primary {
  background: #07C160;
  color: #fff;
}

.empty-state-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  padding: 16rpx 0;
}
