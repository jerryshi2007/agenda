/* components/week-view/index.wxss */

.week-container {
  flex: 1;
  display: flex;
  flex-direction: column;
  background: var(--color-bg-white);
}

.weekday-header-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 0;
}

.weekday-name {
  font-size: var(--font-size-sm);
  color: inherit;
}

.weekday-day {
  font-size: var(--font-size-lg);
  font-weight: 500;
  margin-top: 4rpx;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: var(--radius-round);
}

.weekday-today {
  color: var(--color-primary);
}

.weekday-day-today {
  background: var(--color-primary);
  color: var(--color-text-white);
}

.week-body {
  flex: 1;
  background: var(--color-bg-page);
}
